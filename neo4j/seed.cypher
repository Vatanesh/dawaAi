MERGE (m)-[k:CONTAINS]->(i) SET k.strength = r.strength;

UNWIND [{id: 'grapefruit', name: 'Grapefruit juice'}, {id: 'leafy-greens', name: 'Leafy greens (spinach, kale)'}, {id: 'alcohol', name: 'Alcohol'}, {id: 'coffee', name: 'Coffee'}, {id: 'dairy', name: 'Milk and dairy'}, {id: 'cranberry', name: 'Cranberry juice'}, {id: 'high-potassium', name: 'Potassium salt substitutes and very high-potassium foods'}] AS r MERGE (f:Food {id: r.id}) SET f.name = r.name;

UNWIND [{id: 'vitamin-b12', name: 'Vitamin B12'}, {id: 'coq10', name: 'Coenzyme Q10'}, {id: 'magnesium-n', name: 'Magnesium'}, {id: 'calcium-n', name: 'Calcium'}, {id: 'zinc', name: 'Zinc'}, {id: 'folate', name: 'Folate'}, {id: 'sodium', name: 'Sodium'}, {id: 'potassium-n', name: 'Potassium'}, {id: 'vitamin-d-n', name: 'Vitamin D'}] AS r MERGE (n:Nutrient {id: r.id}) SET n.name = r.name;

UNWIND [{id: 'atrial-fibrillation', name: 'Atrial fibrillation', icd10: 'I48'}, {id: 'hypertension', name: 'High blood pressure', icd10: 'I10'}, {id: 'type-2-diabetes', name: 'Type 2 diabetes', icd10: 'E11'}, {id: 'hypothyroidism', name: 'Underactive thyroid', icd10: 'E03.9'}, {id: 'osteoarthritis', name: 'Osteoarthritis', icd10: 'M19.90'}, {id: 'chronic-kidney-disease', name: 'Chronic kidney disease', icd10: 'N18'}, {id: 'heart-failure', name: 'Heart failure', icd10: 'I50'}, {id: 'depression', name: 'Depression', icd10: 'F32.A'}, {id: 'osteoporosis', name: 'Osteoporosis', icd10: 'M81.0'}, {id: 'gerd', name: 'Acid reflux (GERD)', icd10: 'K21.9'}, {id: 'insomnia', name: 'Insomnia', icd10: 'G47.00'}, {id: 'ulcer-history', name: 'History of stomach ulcer', icd10: 'Z87.11'}, {id: 'fall-risk', name: 'High fall risk', icd10: 'Z91.81'}, {id: 'dementia', name: 'Dementia', icd10: 'F03.90'}] AS r MERGE (c:Condition {id: r.id}) SET c.name = r.name, c.icd10 = r.icd10;

UNWIND [{a: 'warfarin', b: 'ibuprofen', props: {severity: 'major', effect: 'Much higher risk of serious bleeding, especially stomach bleeding.', mechanism: 'NSAIDs block platelets and irritate the stomach lining on top of warfarin\'s anticoagulation.', recommendation: 'Avoid ibuprofen. Ask the prescriber what to use for pain instead; acetaminophen at modest doses is usually preferred.'}}, {a: 'warfarin', b: 'aspirin', props: {severity: 'major', effect: 'Higher risk of serious bleeding.', mechanism: 'Aspirin disables platelets while warfarin slows clotting factors.', recommendation: 'Only combine if a cardiologist has deliberately prescribed both. Otherwise stop the aspirin after checking with the prescriber.'}}, {a: 'warfarin', b: 'vitamin-k', props: {severity: 'moderate', effect: 'Vitamin K works against warfarin, so changes in intake make the INR unstable.', mechanism: 'Warfarin works by blocking vitamin K-dependent clotting factors.', recommendation: 'Do not stop or start the multivitamin suddenly. Keep taking it consistently and tell the anticoagulation clinic it contains vitamin K so the dose can be set around it.'}}, {a: 'warfarin', b: 'omega-3', props: {severity: 'moderate', effect: 'May add to bleeding risk, mostly at higher doses (over 3 g a day).', recommendation: 'Tell the prescriber about the fish oil. Watch for unusual bruising or bleeding gums.'}}, {a: 'warfarin', b: 'vitamin-e', props: {severity: 'minor', effect: 'High doses (over 400 IU a day) may increase bleeding; the amount in a multivitamin is usually fine.', recommendation: 'Avoid extra vitamin E supplements beyond the multivitamin.'}}, {a: 'warfarin', b: 'ginkgo', props: {severity: 'major', effect: 'Reports of serious bleeding when ginkgo is combined with warfarin.', recommendation: 'Stop ginkgo before starting warfarin, after checking with the prescriber.'}}, {a: 'warfarin', b: 'omeprazole', props: {severity: 'minor', effect: 'May slightly raise warfarin levels and INR.', mechanism: 'Omeprazole slows one of the liver enzymes (CYP2C19) that clears warfarin.', recommendation: 'Usually fine. The clinic may check INR a little more often at the start.'}}, {a: 'warfarin', b: 'atorvastatin', props: {severity: 'minor', effect: 'Small changes in INR have been reported when starting a statin.', recommendation: 'No change needed; INR is checked routinely.'}}, {a: 'warfarin', b: 'acetaminophen', props: {severity: 'moderate', effect: 'Regular use above 2 g a day for several days can raise INR.', recommendation: 'Occasional use is fine. For daily use, keep under 2 g a day and tell the clinic.'}}, {a: 'warfarin', b: 'levothyroxine', props: {severity: 'moderate', effect: 'Changes in thyroid dose can strengthen warfarin\'s effect.', recommendation: 'Make sure both prescribers know about each other. INR should be rechecked after any thyroid dose change.'}}, {a: 'warfarin', b: 'clarithromycin', props: {severity: 'major', effect: 'Can sharply raise INR and cause bleeding.', mechanism: 'Clarithromycin blocks the liver enzymes that clear warfarin.', recommendation: 'Ask for a different antibiotic, or have INR checked within 3 to 5 days.'}}, {a: 'warfarin', b: 'ciprofloxacin', props: {severity: 'major', effect: 'Can raise INR and cause bleeding.', recommendation: 'Ask whether another antibiotic suits, or arrange an early INR check.'}}, {a: 'warfarin', b: 'fluconazole', props: {severity: 'major', effect: 'Strongly raises warfarin levels; bleeding risk.', recommendation: 'The warfarin dose usually needs reducing. Tell the anticoagulation clinic before starting.'}}, {a: 'warfarin', b: 'amiodarone', props: {severity: 'major', effect: 'Raises warfarin levels for weeks to months.', recommendation: 'Warfarin dose is normally reduced by a third to a half, with close INR checks.'}}, {a: 'warfarin', b: 'sertraline', props: {severity: 'moderate', effect: 'Higher bleeding risk.', mechanism: 'SSRIs reduce serotonin in platelets, weakening clotting.', recommendation: 'Watch for bruising, black stools or nosebleeds.'}}, {a: 'warfarin', b: 'st-johns-wort', props: {severity: 'major', effect: 'Makes warfarin less effective, raising the risk of a clot or stroke.', mechanism: 'St John\'s wort speeds up the liver enzymes that clear warfarin.', recommendation: 'Avoid. If already taking it, do not stop suddenly without the clinic\'s advice.'}}, {a: 'warfarin', b: 'tramadol', props: {severity: 'moderate', effect: 'INR increases have been reported.', recommendation: 'Check INR after starting or stopping tramadol.'}}, {a: 'warfarin', b: 'apixaban', props: {severity: 'major', effect: 'Two blood thinners together greatly raise bleeding risk.', recommendation: 'These should not be taken together except during a supervised switch.'}}, {a: 'apixaban', b: 'ibuprofen', props: {severity: 'major', effect: 'Higher risk of serious bleeding.', recommendation: 'Avoid ibuprofen. Ask the prescriber for a safer pain option.'}}, {a: 'apixaban', b: 'aspirin', props: {severity: 'major', effect: 'Higher risk of serious bleeding.', recommendation: 'Only combine if deliberately prescribed together.'}}, {a: 'apixaban', b: 'clopidogrel', props: {severity: 'major', effect: 'Higher risk of serious bleeding.', recommendation: 'Only combine under specialist supervision, usually for a limited time.'}}, {a: 'apixaban', b: 'omega-3', props: {severity: 'minor', effect: 'May slightly add to bleeding risk at high doses.', recommendation: 'Mention the fish oil to the prescriber.'}}, {a: 'apixaban', b: 'ginkgo', props: {severity: 'moderate', effect: 'May add to bleeding risk.', recommendation: 'Avoid ginkgo while on a blood thinner.'}}, {a: 'apixaban', b: 'vitamin-e', props: {severity: 'minor', effect: 'High-dose vitamin E may add to bleeding risk.', recommendation: 'Avoid extra vitamin E beyond a multivitamin.'}}, {a: 'apixaban', b: 'clarithromycin', props: {severity: 'moderate', effect: 'Raises apixaban levels.', recommendation: 'Usually acceptable for a short course; watch for bleeding.'}}, {a: 'apixaban', b: 'fluconazole', props: {severity: 'moderate', effect: 'Raises apixaban levels.', recommendation: 'Watch for bleeding during the course.'}}, {a: 'apixaban', b: 'st-johns-wort', props: {severity: 'major', effect: 'Lowers apixaban levels, raising clot and stroke risk.', recommendation: 'Avoid the combination.'}}, {a: 'apixaban', b: 'sertraline', props: {severity: 'moderate', effect: 'Higher bleeding risk.', recommendation: 'Watch for bruising or black stools.'}}, {a: 'rivaroxaban', b: 'ibuprofen', props: {severity: 'major', effect: 'Higher risk of serious bleeding.', recommendation: 'Avoid ibuprofen.'}}, {a: 'rivaroxaban', b: 'aspirin', props: {severity: 'major', effect: 'Higher risk of serious bleeding.', recommendation: 'Only combine if deliberately prescribed together.'}}, {a: 'rivaroxaban', b: 'clarithromycin', props: {severity: 'moderate', effect: 'Raises rivaroxaban levels.', recommendation: 'Watch for bleeding during the course.'}}, {a: 'rivaroxaban', b: 'st-johns-wort', props: {severity: 'major', effect: 'Lowers rivaroxaban levels.', recommendation: 'Avoid the combination.'}}, {a: 'rivaroxaban', b: 'sertraline', props: {severity: 'moderate', effect: 'Higher bleeding risk.', recommendation: 'Watch for bruising or black stools.'}}, {a: 'rivaroxaban', b: 'warfarin', props: {severity: 'major', effect: 'Two blood thinners together greatly raise bleeding risk.', recommendation: 'Not to be combined except during a supervised switch.'}}, {a: 'clopidogrel', b: 'omeprazole', props: {severity: 'major', effect: 'Omeprazole can stop clopidogrel from working properly, raising heart attack and stroke risk.', mechanism: 'Clopidogrel must be activated by CYP2C19, which omeprazole blocks.', recommendation: 'Ask the prescriber about switching the acid reducer to pantoprazole or famotidine.'}}, {a: 'clopidogrel', b: 'aspirin', props: {severity: 'moderate', effect: 'Higher bleeding risk. Often prescribed together on purpose after a stent.', recommendation: 'Confirm the combination is intended and for how long.'}}, {a: 'lisinopril', b: 'ibuprofen', props: {severity: 'moderate', effect: 'Weakens blood pressure control and can strain the kidneys, especially in older adults.', recommendation: 'Limit ibuprofen to the occasional dose, or ask about acetaminophen or a topical gel for joint pain.'}}, {a: 'lisinopril', b: 'naproxen', props: {severity: 'moderate', effect: 'Weakens blood pressure control and can strain the kidneys.', recommendation: 'Limit use and ask about alternatives.'}}, {a: 'lisinopril', b: 'potassium-chloride', props: {severity: 'major', effect: 'Potassium can build up to dangerous levels, affecting heart rhythm.', recommendation: 'Only take together with regular blood tests ordered by the prescriber.'}}, {a: 'lisinopril', b: 'spironolactone', props: {severity: 'major', effect: 'Potassium can build up to dangerous levels.', recommendation: 'Needs regular potassium and kidney blood tests.'}}, {a: 'spironolactone', b: 'potassium-chloride', props: {severity: 'major', effect: 'Potassium can build up to dangerous levels.', recommendation: 'Usually avoided; check with the prescriber.'}}, {a: 'atorvastatin', b: 'clarithromycin', props: {severity: 'major', effect: 'Statin levels rise, risking serious muscle damage.', recommendation: 'Ask whether to pause the statin during the antibiotic course.'}}, {a: 'simvastatin', b: 'clarithromycin', props: {severity: 'major', effect: 'Statin levels rise sharply; serious muscle damage risk.', recommendation: 'Do not take together. Pause simvastatin during the course, as advised by the prescriber.'}}, {a: 'simvastatin', b: 'amlodipine', props: {severity: 'moderate', effect: 'Raises simvastatin levels.', recommendation: 'Simvastatin should not exceed 20 mg a day with amlodipine.'}}, {a: 'simvastatin', b: 'amiodarone', props: {severity: 'major', effect: 'Raises simvastatin levels; muscle damage risk.', recommendation: 'Simvastatin should not exceed 20 mg a day with amiodarone.'}}, {a: 'atorvastatin', b: 'fluconazole', props: {severity: 'moderate', effect: 'Raises statin levels.', recommendation: 'Report any unexplained muscle pain.'}}, {a: 'simvastatin', b: 'fluconazole', props: {severity: 'major', effect: 'Raises simvastatin levels; muscle damage risk.', recommendation: 'Ask whether to pause simvastatin during the course.'}}, {a: 'amiodarone', b: 'metoprolol', props: {severity: 'moderate', effect: 'Heart rate can drop too low.', recommendation: 'Check pulse; report dizziness or fainting.'}}, {a: 'levothyroxine', b: 'calcium', props: {severity: 'moderate', effect: 'Calcium binds levothyroxine in the gut so less is absorbed.', recommendation: 'Take them at least 4 hours apart.', separateHours: 4}}, {a: 'levothyroxine', b: 'iron', props: {severity: 'moderate', effect: 'Iron binds levothyroxine in the gut so less is absorbed.', recommendation: 'Take them at least 4 hours apart.', separateHours: 4}}, {a: 'levothyroxine', b: 'magnesium', props: {severity: 'minor', effect: 'Magnesium can reduce levothyroxine absorption.', recommendation: 'Take them at least 4 hours apart.', separateHours: 4}}, {a: 'levothyroxine', b: 'omeprazole', props: {severity: 'minor', effect: 'Lower stomach acid can reduce levothyroxine absorption over time.', recommendation: 'No change needed; thyroid levels are checked routinely.'}}, {a: 'alendronate', b: 'calcium', props: {severity: 'moderate', effect: 'Calcium blocks alendronate absorption, so the bone medicine stops working.', recommendation: 'Take alendronate first with plain water, then wait at least 30 to 60 minutes before calcium or food.', separateHours: 1}}, {a: 'alendronate', b: 'iron', props: {severity: 'moderate', effect: 'Iron blocks alendronate absorption.', recommendation: 'Take alendronate first, then wait at least 30 to 60 minutes.', separateHours: 1}}, {a: 'alendronate', b: 'magnesium', props: {severity: 'moderate', effect: 'Magnesium blocks alendronate absorption.', recommendation: 'Take alendronate first, then wait at least 30 to 60 minutes.', separateHours: 1}}, {a: 'alendronate', b: 'naproxen', props: {severity: 'minor', effect: 'Both can irritate the stomach and food pipe.', recommendation: 'Report heartburn or pain when swallowing.'}}, {a: 'alendronate', b: 'ibuprofen', props: {severity: 'minor', effect: 'Both can irritate the stomach and food pipe.', recommendation: 'Report heartburn or pain when swallowing.'}}, {a: 'ciprofloxacin', b: 'calcium', props: {severity: 'moderate', effect: 'Calcium blocks antibiotic absorption.', recommendation: 'Take ciprofloxacin 2 hours before or 6 hours after calcium.', separateHours: 6}}, {a: 'ciprofloxacin', b: 'iron', props: {severity: 'moderate', effect: 'Iron blocks antibiotic absorption.', recommendation: 'Take ciprofloxacin 2 hours before or 6 hours after iron.', separateHours: 6}}, {a: 'ciprofloxacin', b: 'magnesium', props: {severity: 'moderate', effect: 'Magnesium blocks antibiotic absorption.', recommendation: 'Take ciprofloxacin 2 hours before or 6 hours after magnesium.', separateHours: 6}}, {a: 'ciprofloxacin', b: 'metformin', props: {severity: 'moderate', effect: 'Blood sugar can swing too high or too low.', recommendation: 'Check blood sugar more often during the course.'}}, {a: 'sertraline', b: 'tramadol', props: {severity: 'major', effect: 'Risk of serotonin syndrome (agitation, sweating, tremor, fever) and seizures.', recommendation: 'Discuss with both prescribers soon. Seek urgent care for confusion, high fever or muscle twitching.'}}, {a: 'sertraline', b: 'st-johns-wort', props: {severity: 'major', effect: 'Risk of serotonin syndrome.', recommendation: 'Stop St John\'s wort after checking with the psychiatrist.'}}, {a: 'tramadol', b: 'st-johns-wort', props: {severity: 'moderate', effect: 'Adds to serotonin syndrome risk.', recommendation: 'Avoid St John\'s wort while taking tramadol.'}}, {a: 'sertraline', b: 'ibuprofen', props: {severity: 'moderate', effect: 'Higher risk of stomach bleeding.', recommendation: 'Prefer acetaminophen; if an NSAID is needed, ask about stomach protection.'}}, {a: 'sertraline', b: 'aspirin', props: {severity: 'moderate', effect: 'Higher risk of stomach bleeding.', recommendation: 'Watch for black stools or stomach pain.'}}, {a: 'tramadol', b: 'zolpidem', props: {severity: 'major', effect: 'Combined sedation can slow breathing and cause falls.', recommendation: 'Ask the prescribers whether both are still needed; never take extra doses at night.'}}, {a: 'tramadol', b: 'diphenhydramine', props: {severity: 'moderate', effect: 'Extra drowsiness and confusion.', recommendation: 'Avoid night-time antihistamine sleep aids while on tramadol.'}}, {a: 'zolpidem', b: 'diphenhydramine', props: {severity: 'moderate', effect: 'Two sleep aids together cause next-day grogginess and falls.', recommendation: 'Do not combine. Choose one, with the prescriber\'s advice.'}}, {a: 'sertraline', b: 'zolpidem', props: {severity: 'minor', effect: 'Slightly more drowsiness.', recommendation: 'Take zolpidem only when going straight to bed.'}}, {a: 'amiodarone', b: 'digoxin', props: {severity: 'major', effect: 'Amiodarone raises digoxin levels, risking digoxin toxicity (nausea, vision changes, very slow heartbeat).', recommendation: 'The digoxin dose is usually reduced and blood levels checked.'}}, {a: 'clarithromycin', b: 'digoxin', props: {severity: 'major', effect: 'Clarithromycin can sharply raise digoxin levels.', recommendation: 'Ask for a different antibiotic or a digoxin level check.'}}, {a: 'citalopram', b: 'amiodarone', props: {severity: 'major', effect: 'Both prolong the QT interval, risking a dangerous heart rhythm.', recommendation: 'Usually avoided; if needed, an ECG should be checked.'}}, {a: 'escitalopram', b: 'amiodarone', props: {severity: 'moderate', effect: 'Both can prolong the QT interval.', recommendation: 'Ask whether an ECG is needed.'}}, {a: 'quetiapine', b: 'amiodarone', props: {severity: 'major', effect: 'Both prolong the QT interval; the quetiapine label says the combination should be avoided because of the risk of a dangerous heart rhythm.', recommendation: 'Ask the prescriber for an alternative to quetiapine. If both must continue, an ECG and potassium/magnesium check are needed.'}}, {a: 'gabapentin', b: 'oxycodone', props: {severity: 'major', effect: 'Gabapentin with opioids can slow breathing dangerously (FDA warning).', recommendation: 'Use the lowest doses; watch for unusual sleepiness or slow breathing.'}}, {a: 'gabapentin', b: 'tramadol', props: {severity: 'moderate', effect: 'Extra drowsiness and slowed breathing.', recommendation: 'Watch for unusual sleepiness.'}}, {a: 'glipizide', b: 'fluconazole', props: {severity: 'moderate', effect: 'Fluconazole raises glipizide levels: risk of low blood sugar.', recommendation: 'Check blood sugar more often during the course.'}}, {a: 'glipizide', b: 'clarithromycin', props: {severity: 'moderate', effect: 'Risk of low blood sugar.', recommendation: 'Check blood sugar more often during the course.'}}, {a: 'dabigatran', b: 'amiodarone', props: {severity: 'moderate', effect: 'Amiodarone raises dabigatran levels.', recommendation: 'The prescriber may adjust the dose; watch for bleeding.'}}, {a: 'dabigatran', b: 'clarithromycin', props: {severity: 'moderate', effect: 'Clarithromycin raises dabigatran levels.', recommendation: 'Watch for bleeding during the course.'}}, {a: 'donepezil', b: 'metoprolol', props: {severity: 'moderate', effect: 'Together they can slow the heart rate too much, causing dizziness or fainting.', recommendation: 'Check pulse; report fainting or falls.'}}, {a: 'allopurinol', b: 'furosemide', props: {severity: 'minor', effect: 'Diuretics can raise uric acid and allopurinol levels.', recommendation: 'Usually fine; routine blood tests cover it.'}}, {a: 'amiodarone', b: 'clarithromycin', props: {severity: 'major', effect: 'Both prolong the QT interval and clarithromycin raises amiodarone levels: risk of a dangerous heart rhythm (torsades).', recommendation: 'Ask for a different antibiotic. If unavoidable, an ECG and potassium/magnesium check are needed.'}}, {a: 'amiodarone', b: 'fluconazole', props: {severity: 'major', effect: 'Both prolong the QT interval: risk of a dangerous heart rhythm.', recommendation: 'Ask for a different antifungal, or an ECG and potassium/magnesium check.'}}, {a: 'amiodarone', b: 'ciprofloxacin', props: {severity: 'major', effect: 'Both prolong the QT interval: risk of a dangerous heart rhythm.', recommendation: 'Ask for a different antibiotic, or an ECG and potassium/magnesium check.'}}, {a: 'oxycodone', b: 'clarithromycin', props: {severity: 'major', effect: 'Clarithromycin blocks the liver enzyme that clears oxycodone, so levels can climb to dangerous drowsiness and slowed breathing (FDA boxed warning).', mechanism: 'CYP3A4 inhibition.', recommendation: 'Ask for a different antibiotic. If both are needed, the oxycodone dose may need lowering; watch closely for unusual sleepiness or slow breathing.'}}, {a: 'oxycodone', b: 'fluconazole', props: {severity: 'moderate', effect: 'Fluconazole raises oxycodone levels, adding to drowsiness and slowed breathing.', mechanism: 'CYP3A4 inhibition.', recommendation: 'Watch for unusual sleepiness during the course; ask whether the dose should be lowered.'}}, {a: 'citalopram', b: 'omeprazole', props: {severity: 'moderate', effect: 'Omeprazole slows the breakdown of citalopram, raising its level and the chance of a heart-rhythm (QT) problem.', mechanism: 'CYP2C19 inhibition.', recommendation: 'Citalopram should not exceed 20 mg a day with omeprazole (and over age 60). Ask whether pantoprazole or famotidine could replace the omeprazole.'}}, {a: 'escitalopram', b: 'omeprazole', props: {severity: 'moderate', effect: 'Omeprazole slows the breakdown of escitalopram, raising its level and the chance of a heart-rhythm (QT) problem.', mechanism: 'CYP2C19 inhibition.', recommendation: 'Ask whether a lower dose or a different acid reducer is appropriate.'}}, {a: 'st-johns-wort', b: 'edoxaban', props: {severity: 'major', effect: 'St John\'s wort lowers edoxaban levels, raising clot and stroke risk.', recommendation: 'Avoid the combination; tell the prescriber before stopping St John\'s wort.'}}, {a: 'st-johns-wort', b: 'oxycodone', props: {severity: 'moderate', effect: 'St John\'s wort can lower oxycodone levels so pain relief fades, and adds to serotonin effects.', recommendation: 'Avoid St John\'s wort while taking oxycodone.'}}, {a: 'st-johns-wort', b: 'simvastatin', props: {severity: 'moderate', effect: 'St John\'s wort lowers simvastatin levels, so cholesterol control weakens.', recommendation: 'Avoid the combination or have cholesterol rechecked.'}}, {a: 'st-johns-wort', b: 'atorvastatin', props: {severity: 'moderate', effect: 'St John\'s wort lowers atorvastatin levels, so cholesterol control weakens.', recommendation: 'Avoid the combination or have cholesterol rechecked.'}}, {a: 'st-johns-wort', b: 'amlodipine', props: {severity: 'minor', effect: 'St John\'s wort may lower amlodipine levels slightly.', recommendation: 'Mention it at the next blood-pressure check.'}}] AS r MATCH (a:ActiveIngredient {id: r.a}), (b:ActiveIngredient {id: r.b})
MERGE (a)-[e:INTERACTS_WITH]->(b) SET e += r.props;

UNWIND [{a: 'M01A', b: 'B01A', props: {severity: 'major', effect: 'Any NSAID pain reliever combined with a blood thinner or antiplatelet raises the risk of serious bleeding.', recommendation: 'Avoid the NSAID unless the prescriber has approved it; acetaminophen is usually preferred.'}}, {a: 'N06AB', b: 'B01A', props: {severity: 'moderate', effect: 'SSRIs weaken platelets, adding to the bleeding risk of antithrombotic medicines.', recommendation: 'Watch for bruising, nosebleeds or black stools.'}}, {a: 'N02A', b: 'N05C', props: {severity: 'major', effect: 'Opioids with sleep medicines can cause heavy sedation, slowed breathing and falls.', recommendation: 'Ask the prescribers to review whether both are needed.'}}, {a: 'N02A', b: 'R06AA', props: {severity: 'moderate', effect: 'Opioids with sedating antihistamines add drowsiness and confusion.', recommendation: 'Avoid night-time antihistamine sleep aids.'}}, {a: 'N05C', b: 'R06AA', props: {severity: 'moderate', effect: 'Two sedating medicines together cause next-day grogginess and falls.', recommendation: 'Do not combine without the prescriber\'s advice.'}}, {a: 'M01A', b: 'C09A', props: {severity: 'moderate', effect: 'NSAIDs weaken ACE inhibitors and can strain the kidneys.', recommendation: 'Keep NSAID use occasional and check blood pressure.'}}, {a: 'C09A', b: 'C03DA', props: {severity: 'major', effect: 'ACE inhibitors with aldosterone antagonists can push potassium dangerously high.', recommendation: 'Needs regular potassium blood tests.'}}, {a: 'C09A', b: 'A12BA', props: {severity: 'major', effect: 'ACE inhibitors with potassium supplements can push potassium dangerously high.', recommendation: 'Only with blood test monitoring.'}}, {a: 'N05B', b: 'N02A', props: {severity: 'major', effect: 'Benzodiazepines with opioids can cause profound sedation, slowed breathing and death (FDA boxed warning).', recommendation: 'Ask the prescribers to review together; never take extra doses.'}}, {a: 'N03AE', b: 'N02A', props: {severity: 'major', effect: 'Benzodiazepines with opioids can cause profound sedation and slowed breathing (FDA boxed warning).', recommendation: 'Ask the prescribers to review together.'}}, {a: 'N05B', b: 'N05C', props: {severity: 'moderate', effect: 'Two sedatives together cause next-day drowsiness, confusion and falls.', recommendation: 'Ask whether both are needed.'}}, {a: 'N05A', b: 'N02A', props: {severity: 'moderate', effect: 'Antipsychotics with opioids add sedation and fall risk.', recommendation: 'Watch for heavy drowsiness.'}}, {a: 'N05A', b: 'N05C', props: {severity: 'moderate', effect: 'Two sedating medicines add up: drowsiness and falls.', recommendation: 'Ask whether both are needed.'}}, {a: 'M01A', b: 'C03', props: {severity: 'moderate', effect: 'NSAIDs blunt water pills and, especially alongside an ACE inhibitor or ARB, can injure the kidneys.', recommendation: 'Avoid regular NSAID use; ask about acetaminophen.'}}, {a: 'M01A', b: 'C09C', props: {severity: 'moderate', effect: 'NSAIDs weaken ARBs and can strain the kidneys.', recommendation: 'Keep NSAID use occasional and check blood pressure.'}}, {a: 'C09C', b: 'C03DA', props: {severity: 'major', effect: 'ARBs with aldosterone antagonists can push potassium dangerously high.', recommendation: 'Needs regular potassium blood tests.'}}, {a: 'C09C', b: 'A12BA', props: {severity: 'major', effect: 'ARBs with potassium supplements can push potassium dangerously high.', recommendation: 'Only with blood test monitoring.'}}, {a: 'M01A', b: 'H02AB', props: {severity: 'moderate', effect: 'NSAIDs with steroids raise the risk of stomach ulcers and bleeding.', recommendation: 'Ask about stomach protection.'}}, {a: 'N06AB', b: 'M01A', props: {severity: 'moderate', effect: 'SSRIs with NSAIDs raise the risk of stomach bleeding.', recommendation: 'Prefer acetaminophen; if an NSAID is needed, ask about stomach protection.'}}, {a: 'N06DA', b: 'R06AA', props: {severity: 'moderate', effect: 'Sedating antihistamines work against dementia medicines and can cause confusion.', recommendation: 'Avoid antihistamine sleep aids; ask about alternatives.'}}, {a: 'C01AA', b: 'C03CA', props: {severity: 'moderate', effect: 'Loop diuretics lower potassium and magnesium, making digoxin toxicity more likely.', recommendation: 'Potassium and digoxin levels should be monitored.'}}, {a: 'C01AA', b: 'C03AA', props: {severity: 'moderate', effect: 'Thiazide diuretics lower potassium and magnesium, making digoxin toxicity more likely.', recommendation: 'Potassium and digoxin levels should be monitored.'}}, {a: 'B01A', b: 'B01A', props: {severity: 'major', effect: 'Two blood thinners or antiplatelet medicines together greatly raise the risk of serious bleeding.', recommendation: 'Only ever combined deliberately by a cardiologist, usually for a limited time. Otherwise call the prescriber before the next dose.'}}, {a: 'N06A', b: 'N02AX', props: {severity: 'major', effect: 'Tramadol with an antidepressant (SSRI, SNRI or tricyclic) raises the risk of serotonin syndrome (agitation, sweating, tremor, fever) and seizures.', recommendation: 'Discuss with both prescribers soon. Seek urgent care for confusion, high fever or muscle twitching.'}}, {a: 'N06AX', b: 'N06AB', props: {severity: 'major', effect: 'St John\'s wort with an SSRI risks serotonin syndrome (agitation, sweating, tremor, fever).', recommendation: 'Stop St John\'s wort after checking with the prescriber.'}}, {a: 'N06AX', b: 'N06AA', props: {severity: 'major', effect: 'St John\'s wort with a tricyclic antidepressant risks serotonin syndrome and lowers the antidepressant\'s level.', recommendation: 'Stop St John\'s wort after checking with the prescriber.'}}, {a: 'N06AX', b: 'B01AE', props: {severity: 'major', effect: 'St John\'s wort lowers dabigatran levels, raising clot and stroke risk.', recommendation: 'Avoid the combination.'}}, {a: 'N06AX', b: 'C01AA', props: {severity: 'major', effect: 'St John\'s wort lowers digoxin levels by about a quarter, so the heart medicine stops working properly.', recommendation: 'Avoid the combination; digoxin levels need rechecking if it is stopped or started.'}}, {a: 'C09A', b: 'C09C', props: {severity: 'major', effect: 'An ACE inhibitor and an ARB together (\'dual RAS blockade\') give no extra benefit but raise the risk of dangerously high potassium, low blood pressure and kidney injury; the labels say the combination is not recommended.', recommendation: 'Usually one of the two should be stopped. Ask the prescribers to decide which, and request potassium and kidney blood tests. This often happens when two doctors each prescribe a blood-pressure tablet.'}}, {a: 'J01MA', b: 'H02AB', props: {severity: 'major', effect: 'Fluoroquinolone antibiotics with a steroid sharply raise the risk of tendon damage or rupture, especially over age 60; it can happen during or months after the course (FDA boxed warning).', recommendation: 'Ask whether a different antibiotic suits. Stop the antibiotic and call the prescriber at the first sign of tendon pain, swelling or a snap.'}}, {a: 'J01MA', b: 'A10BB', props: {severity: 'major', effect: 'Fluoroquinolone antibiotics with a sulfonylurea can cause severe, sometimes prolonged low blood sugar, especially in older adults (FDA warning).', recommendation: 'Check blood sugar several times a day during the course and keep glucose tablets to hand. Ask whether a different antibiotic suits.'}}, {a: 'N03AE', b: 'N05C', props: {severity: 'moderate', effect: 'A benzodiazepine with a sleep medicine doubles the sedation, confusion and fall risk.', recommendation: 'Ask whether both are needed; never take extra doses at night.'}}, {a: 'N03AE', b: 'R06AA', props: {severity: 'moderate', effect: 'A benzodiazepine with a sedating antihistamine adds drowsiness, confusion and fall risk.', recommendation: 'Avoid antihistamine sleep aids while taking it.'}}, {a: 'N05BA', b: 'N03AE', props: {severity: 'major', effect: 'Two benzodiazepines at once double the sedation, confusion and fall risk; both are on the Beers list of medicines to avoid in older adults.', recommendation: 'Ask the prescribers to agree on one and plan a gradual taper of the other; never stop a benzodiazepine suddenly.'}}, {a: 'C01BD', b: 'J01FA', props: {severity: 'major', effect: 'Amiodarone with a macrolide antibiotic prolongs the QT interval: risk of a dangerous heart rhythm.', recommendation: 'Ask for a different antibiotic, or an ECG and potassium/magnesium check.'}}, {a: 'C01BD', b: 'J01MA', props: {severity: 'major', effect: 'Amiodarone with a fluoroquinolone antibiotic prolongs the QT interval: risk of a dangerous heart rhythm.', recommendation: 'Ask for a different antibiotic, or an ECG and potassium/magnesium check.'}}, {a: 'C01BD', b: 'J02AC', props: {severity: 'major', effect: 'Amiodarone with an azole antifungal prolongs the QT interval: risk of a dangerous heart rhythm.', recommendation: 'Ask for a different antifungal, or an ECG and potassium/magnesium check.'}}] AS r MATCH (a:DrugClass {id: r.a}), (b:DrugClass {id: r.b})
MERGE (a)-[e:CLASS_INTERACTS_WITH]->(b) SET e += r.props;

UNWIND [{ingredient: 'warfarin', food: 'leafy-greens', props: {severity: 'moderate', effect: 'Vitamin K in greens counteracts warfarin; big swings in how much is eaten make INR unstable.', recommendation: 'Keep eating greens, but in a steady amount each week rather than cutting them out.'}}, {ingredient: 'warfarin', food: 'grapefruit', props: {severity: 'minor', effect: 'Large amounts of grapefruit may raise warfarin levels slightly.', recommendation: 'A small glass is unlikely to matter; avoid large or changing amounts and mention it to the clinic.'}}, {ingredient: 'warfarin', food: 'cranberry', props: {severity: 'moderate', effect: 'Large amounts of cranberry juice have been linked to raised INR.', recommendation: 'Keep to a small glass, or avoid.'}}, {ingredient: 'warfarin', food: 'alcohol', props: {severity: 'moderate', effect: 'Binge drinking or changes in drinking affect INR and bleeding risk.', recommendation: 'Keep to no more than 1 to 2 drinks, and keep it steady.'}}, {ingredient: 'apixaban', food: 'grapefruit', props: {severity: 'minor', effect: 'Large amounts of grapefruit may raise apixaban levels.', recommendation: 'Avoid large amounts of grapefruit juice.'}}, {ingredient: 'rivaroxaban', food: 'grapefruit', props: {severity: 'minor', effect: 'Large amounts of grapefruit may raise rivaroxaban levels.', recommendation: 'Avoid large amounts of grapefruit juice.'}}, {ingredient: 'apixaban', food: 'alcohol', props: {severity: 'minor', effect: 'Heavy drinking adds to bleeding risk.', recommendation: 'Keep alcohol moderate.'}}, {ingredient: 'atorvastatin', food: 'grapefruit', props: {severity: 'moderate', effect: 'Grapefruit raises atorvastatin levels, increasing the chance of muscle pain or damage.', recommendation: 'Keep to under one small glass a day, or ask about a statin that grapefruit doesn\'t affect (pravastatin or rosuvastatin).'}}, {ingredient: 'simvastatin', food: 'grapefruit', props: {severity: 'major', effect: 'Grapefruit sharply raises simvastatin levels; risk of serious muscle damage.', recommendation: 'Avoid grapefruit completely.'}}, {ingredient: 'amlodipine', food: 'grapefruit', props: {severity: 'minor', effect: 'May raise amlodipine levels a little, causing dizziness or ankle swelling.', recommendation: 'Usually fine in small amounts; report dizziness.'}}, {ingredient: 'metformin', food: 'alcohol', props: {severity: 'moderate', effect: 'Raises the risk of low blood sugar and, rarely, lactic acidosis.', recommendation: 'Avoid heavy drinking and never drink on an empty stomach.'}}, {ingredient: 'zolpidem', food: 'alcohol', props: {severity: 'major', effect: 'Dangerous sedation, sleep-walking behaviours and falls.', recommendation: 'No alcohol on nights zolpidem is taken.'}}, {ingredient: 'tramadol', food: 'alcohol', props: {severity: 'major', effect: 'Slowed breathing and heavy sedation.', recommendation: 'Avoid alcohol while taking tramadol.'}}, {ingredient: 'sertraline', food: 'alcohol', props: {severity: 'moderate', effect: 'More drowsiness, and alcohol can worsen depression.', recommendation: 'Limit alcohol.'}}, {ingredient: 'acetaminophen', food: 'alcohol', props: {severity: 'moderate', effect: 'Raises the risk of liver damage, especially with 3 or more drinks a day.', recommendation: 'Keep acetaminophen under 2 g a day if drinking regularly.'}}, {ingredient: 'diphenhydramine', food: 'alcohol', props: {severity: 'moderate', effect: 'Extra drowsiness and confusion.', recommendation: 'Avoid alcohol with night-time sleep aids.'}}, {ingredient: 'ibuprofen', food: 'alcohol', props: {severity: 'moderate', effect: 'Higher risk of stomach bleeding.', recommendation: 'Avoid drinking when taking ibuprofen.'}}, {ingredient: 'naproxen', food: 'alcohol', props: {severity: 'moderate', effect: 'Higher risk of stomach bleeding.', recommendation: 'Avoid drinking when taking naproxen.'}}, {ingredient: 'levothyroxine', food: 'coffee', props: {severity: 'moderate', effect: 'Coffee within an hour of levothyroxine cuts how much is absorbed.', recommendation: 'Take levothyroxine with water on waking and wait 30 to 60 minutes before coffee.', separateHours: 1}}, {ingredient: 'levothyroxine', food: 'dairy', props: {severity: 'minor', effect: 'Calcium in dairy can reduce absorption.', recommendation: 'Keep milk away from the levothyroxine dose.', separateHours: 1}}, {ingredient: 'alendronate', food: 'coffee', props: {severity: 'moderate', effect: 'Anything other than plain water stops alendronate being absorbed.', recommendation: 'Take it with a full glass of plain water and wait at least 30 minutes before coffee.', separateHours: 1}}, {ingredient: 'alendronate', food: 'dairy', props: {severity: 'moderate', effect: 'Calcium in dairy stops alendronate being absorbed.', recommendation: 'Wait at least 30 minutes before breakfast or milk.', separateHours: 1}}, {ingredient: 'ciprofloxacin', food: 'dairy', props: {severity: 'moderate', effect: 'Calcium in dairy blocks the antibiotic.', recommendation: 'Don\'t take ciprofloxacin with milk or yoghurt on their own.', separateHours: 2}}, {ingredient: 'lisinopril', food: 'high-potassium', props: {severity: 'moderate', effect: 'Salt substitutes and lots of high-potassium foods can push potassium too high.', recommendation: 'Avoid salt substitutes containing potassium; normal fruit intake is fine.'}}, {ingredient: 'spironolactone', food: 'high-potassium', props: {severity: 'moderate', effect: 'Potassium can build up.', recommendation: 'Avoid salt substitutes containing potassium.'}}, {ingredient: 'lorazepam', food: 'alcohol', props: {severity: 'major', effect: 'Dangerous sedation, slowed breathing and falls.', recommendation: 'No alcohol while taking lorazepam.'}}, {ingredient: 'clonazepam', food: 'alcohol', props: {severity: 'major', effect: 'Dangerous sedation and slowed breathing.', recommendation: 'No alcohol while taking clonazepam.'}}, {ingredient: 'oxycodone', food: 'alcohol', props: {severity: 'major', effect: 'Slowed breathing and heavy sedation.', recommendation: 'No alcohol while taking oxycodone.'}}, {ingredient: 'oxycodone', food: 'grapefruit', props: {severity: 'moderate', effect: 'Grapefruit can raise oxycodone levels, adding to sedation.', recommendation: 'Avoid grapefruit juice.'}}, {ingredient: 'gabapentin', food: 'alcohol', props: {severity: 'moderate', effect: 'Extra drowsiness and dizziness.', recommendation: 'Avoid or limit alcohol.'}}, {ingredient: 'quetiapine', food: 'alcohol', props: {severity: 'major', effect: 'Heavy sedation and dizziness.', recommendation: 'Avoid alcohol.'}}, {ingredient: 'quetiapine', food: 'grapefruit', props: {severity: 'moderate', effect: 'Grapefruit can raise quetiapine levels.', recommendation: 'Avoid grapefruit juice.'}}, {ingredient: 'amitriptyline', food: 'alcohol', props: {severity: 'major', effect: 'Heavy sedation and confusion.', recommendation: 'Avoid alcohol.'}}, {ingredient: 'glipizide', food: 'alcohol', props: {severity: 'moderate', effect: 'Raises the risk of low blood sugar.', recommendation: 'Never drink on an empty stomach; limit alcohol.'}}, {ingredient: 'prednisone', food: 'alcohol', props: {severity: 'moderate', effect: 'Raises the risk of stomach irritation and bleeding.', recommendation: 'Limit alcohol.'}}, {ingredient: 'celecoxib', food: 'alcohol', props: {severity: 'moderate', effect: 'Higher risk of stomach bleeding.', recommendation: 'Avoid drinking when taking celecoxib.'}}, {ingredient: 'diclofenac', food: 'alcohol', props: {severity: 'moderate', effect: 'Higher risk of stomach bleeding.', recommendation: 'Avoid drinking when taking diclofenac.'}}, {ingredient: 'losartan', food: 'high-potassium', props: {severity: 'moderate', effect: 'Salt substitutes and lots of high-potassium foods can push potassium too high.', recommendation: 'Avoid potassium salt substitutes.'}}, {ingredient: 'ramipril', food: 'high-potassium', props: {severity: 'moderate', effect: 'Salt substitutes can push potassium too high.', recommendation: 'Avoid potassium salt substitutes.'}}] AS r MATCH (i:ActiveIngredient {id: r.ingredient}), (f:Food {id: r.food})
MERGE (i)-[e:CONFLICTS_WITH]->(f) SET e += r.props;

UNWIND [{ingredient: 'metformin', nutrient: 'vitamin-b12', props: {effect: 'Long-term use lowers vitamin B12, which can cause tiredness, numbness or memory problems.', recommendation: 'Ask for a B12 blood test once a year.'}}, {ingredient: 'metformin', nutrient: 'folate', props: {effect: 'May lower folate over time.', recommendation: 'A balanced diet is usually enough; mention any fatigue.'}}, {ingredient: 'omeprazole', nutrient: 'vitamin-b12', props: {effect: 'Lower stomach acid reduces B12 absorption over time.', recommendation: 'Ask for a B12 check if used for more than 2 years.'}}, {ingredient: 'omeprazole', nutrient: 'magnesium-n', props: {effect: 'Use for over a year can lower magnesium (cramps, irregular heartbeat).', recommendation: 'Ask for a magnesium level check.'}}, {ingredient: 'omeprazole', nutrient: 'calcium-n', props: {effect: 'Reduced calcium absorption, linked to higher fracture risk with long-term use.', recommendation: 'Ask whether the acid reducer is still needed, and keep up calcium and vitamin D.'}}, {ingredient: 'atorvastatin', nutrient: 'coq10', props: {effect: 'Statins lower the body\'s CoQ10; some people link this to muscle aches.', recommendation: 'Report muscle aches. CoQ10 supplements are optional; evidence is mixed.'}}, {ingredient: 'simvastatin', nutrient: 'coq10', props: {effect: 'Statins lower the body\'s CoQ10.', recommendation: 'Report muscle aches.'}}, {ingredient: 'lisinopril', nutrient: 'zinc', props: {effect: 'May increase zinc loss in urine over time.', recommendation: 'Usually no action needed; mention loss of taste.'}}, {ingredient: 'sertraline', nutrient: 'sodium', props: {effect: 'In older adults, SSRIs can cause low sodium, leading to confusion or falls.', recommendation: 'Ask for a sodium blood test in the first weeks and after dose changes.'}}, {ingredient: 'furosemide', nutrient: 'potassium-n', props: {effect: 'Loop diuretics wash out potassium, which can cause cramps and heart rhythm problems.', recommendation: 'Potassium should be checked regularly.'}}, {ingredient: 'furosemide', nutrient: 'magnesium-n', props: {effect: 'Loop diuretics also lower magnesium.', recommendation: 'Ask whether magnesium should be checked.'}}, {ingredient: 'hydrochlorothiazide', nutrient: 'potassium-n', props: {effect: 'Thiazides lower potassium.', recommendation: 'Potassium should be checked regularly.'}}, {ingredient: 'hydrochlorothiazide', nutrient: 'magnesium-n', props: {effect: 'Thiazides can lower magnesium.', recommendation: 'Ask whether magnesium should be checked.'}}, {ingredient: 'prednisone', nutrient: 'calcium-n', props: {effect: 'Long-term steroids weaken bones by reducing calcium absorption.', recommendation: 'Ask about calcium, vitamin D and bone protection.'}}, {ingredient: 'prednisone', nutrient: 'vitamin-d-n', props: {effect: 'Steroids interfere with vitamin D.', recommendation: 'Ask about vitamin D.'}}, {ingredient: 'pantoprazole', nutrient: 'vitamin-b12', props: {effect: 'Lower stomach acid reduces B12 absorption over time.', recommendation: 'Ask for a B12 check if used for more than 2 years.'}}, {ingredient: 'pantoprazole', nutrient: 'magnesium-n', props: {effect: 'Use for over a year can lower magnesium.', recommendation: 'Ask for a magnesium level check.'}}] AS r MATCH (i:ActiveIngredient {id: r.ingredient}), (n:Nutrient {id: r.nutrient})
MERGE (i)-[e:DEPLETES]->(n) SET e += r.props;

UNWIND [{ingredient: 'ibuprofen', condition: 'hypertension', props: {severity: 'moderate', effect: 'NSAIDs can raise blood pressure.', recommendation: 'Use sparingly and check blood pressure.'}}, {ingredient: 'ibuprofen', condition: 'chronic-kidney-disease', props: {severity: 'major', effect: 'Can worsen kidney function.', recommendation: 'Avoid; ask for an alternative.'}}, {ingredient: 'ibuprofen', condition: 'heart-failure', props: {severity: 'major', effect: 'Can cause fluid retention and worsen heart failure.', recommendation: 'Avoid.'}}, {ingredient: 'ibuprofen', condition: 'ulcer-history', props: {severity: 'major', effect: 'High risk of another stomach ulcer or bleed.', recommendation: 'Avoid unless prescribed with stomach protection.'}}, {ingredient: 'naproxen', condition: 'hypertension', props: {severity: 'moderate', effect: 'NSAIDs can raise blood pressure.', recommendation: 'Use sparingly.'}}, {ingredient: 'naproxen', condition: 'chronic-kidney-disease', props: {severity: 'major', effect: 'Can worsen kidney function.', recommendation: 'Avoid.'}}, {ingredient: 'naproxen', condition: 'ulcer-history', props: {severity: 'major', effect: 'High risk of another stomach ulcer or bleed.', recommendation: 'Avoid.'}}, {ingredient: 'diphenhydramine', condition: 'fall-risk', props: {severity: 'major', effect: 'Causes confusion, dizziness and next-day drowsiness in older adults; on the Beers list of drugs to avoid.', recommendation: 'Ask the prescriber about safer sleep options.'}}, {ingredient: 'zolpidem', condition: 'fall-risk', props: {severity: 'major', effect: 'Raises the risk of night-time falls and hip fractures.', recommendation: 'Review with the prescriber whether it is still needed.'}}, {ingredient: 'tramadol', condition: 'fall-risk', props: {severity: 'moderate', effect: 'Opioids are on the 2023 Beers list of medicines to avoid in people with a history of falls: dizziness and drowsiness raise fall risk.', recommendation: 'Ask the prescriber whether it is still needed or a safer pain plan exists.'}}, {ingredient: 'metformin', condition: 'chronic-kidney-disease', props: {severity: 'moderate', effect: 'Dose needs adjusting as kidney function falls.', recommendation: 'Make sure kidney function is checked yearly.'}}, {ingredient: 'spironolactone', condition: 'chronic-kidney-disease', props: {severity: 'major', effect: 'High risk of dangerous potassium levels.', recommendation: 'Needs close blood test monitoring.'}}, {ingredient: 'alendronate', condition: 'gerd', props: {severity: 'moderate', effect: 'Can irritate the food pipe and worsen reflux.', recommendation: 'Stay upright for 30 minutes after the dose; report pain when swallowing.'}}, {ingredient: 'warfarin', condition: 'ulcer-history', props: {severity: 'moderate', effect: 'Higher risk of stomach bleeding.', recommendation: 'Make sure the prescriber knows about the ulcer history.'}}, {ingredient: 'apixaban', condition: 'ulcer-history', props: {severity: 'moderate', effect: 'Higher risk of stomach bleeding.', recommendation: 'Make sure the prescriber knows about the ulcer history.'}}, {ingredient: 'metoprolol', condition: 'type-2-diabetes', props: {severity: 'minor', effect: 'Can hide the shaky, racing-heart warning signs of low blood sugar.', recommendation: 'Rely on glucose readings rather than symptoms.'}}, {ingredient: 'lorazepam', condition: 'fall-risk', props: {severity: 'major', effect: 'Benzodiazepines raise the risk of falls, hip fractures and confusion in older adults (Beers list).', recommendation: 'Ask the prescriber about tapering or safer options.'}}, {ingredient: 'clonazepam', condition: 'fall-risk', props: {severity: 'major', effect: 'Benzodiazepines raise the risk of falls and fractures in older adults.', recommendation: 'Ask the prescriber whether it is still needed.'}}, {ingredient: 'amitriptyline', condition: 'fall-risk', props: {severity: 'major', effect: 'Strongly anticholinergic: dizziness, confusion and falls in older adults (Beers list).', recommendation: 'Ask about safer alternatives.'}}, {ingredient: 'amitriptyline', condition: 'dementia', props: {severity: 'major', effect: 'Anticholinergic effects worsen memory and confusion.', recommendation: 'Ask about alternatives.'}}, {ingredient: 'diphenhydramine', condition: 'dementia', props: {severity: 'major', effect: 'Anticholinergic: worsens memory and confusion.', recommendation: 'Avoid; ask about safer sleep options.'}}, {ingredient: 'quetiapine', condition: 'dementia', props: {severity: 'major', effect: 'Antipsychotics raise the risk of stroke and death in older adults with dementia (FDA boxed warning).', recommendation: 'Ask the prescriber to review whether it is needed.'}}, {ingredient: 'quetiapine', condition: 'fall-risk', props: {severity: 'moderate', effect: 'Drowsiness and low blood pressure on standing raise fall risk.', recommendation: 'Get up slowly.'}}, {ingredient: 'oxycodone', condition: 'fall-risk', props: {severity: 'moderate', effect: 'Opioids are on the 2023 Beers list of medicines to avoid in people with a history of falls: dizziness and drowsiness raise fall risk.', recommendation: 'Ask the prescriber whether it is still needed or a safer pain plan exists.'}}, {ingredient: 'gabapentin', condition: 'fall-risk', props: {severity: 'moderate', effect: 'Dizziness and unsteadiness raise fall risk.', recommendation: 'Report unsteadiness.'}}, {ingredient: 'tamsulosin', condition: 'fall-risk', props: {severity: 'minor', effect: 'Can cause dizziness when standing up.', recommendation: 'Stand up slowly, especially at night.'}}, {ingredient: 'celecoxib', condition: 'chronic-kidney-disease', props: {severity: 'major', effect: 'Can worsen kidney function.', recommendation: 'Avoid; ask for an alternative.'}}, {ingredient: 'celecoxib', condition: 'heart-failure', props: {severity: 'major', effect: 'Can cause fluid retention and worsen heart failure.', recommendation: 'Avoid.'}}, {ingredient: 'celecoxib', condition: 'hypertension', props: {severity: 'moderate', effect: 'Can raise blood pressure.', recommendation: 'Use sparingly and check blood pressure.'}}, {ingredient: 'diclofenac', condition: 'chronic-kidney-disease', props: {severity: 'major', effect: 'Can worsen kidney function.', recommendation: 'Avoid.'}}, {ingredient: 'diclofenac', condition: 'heart-failure', props: {severity: 'major', effect: 'Can worsen heart failure.', recommendation: 'Avoid.'}}, {ingredient: 'diclofenac', condition: 'hypertension', props: {severity: 'moderate', effect: 'Can raise blood pressure.', recommendation: 'Use sparingly.'}}, {ingredient: 'diclofenac', condition: 'ulcer-history', props: {severity: 'major', effect: 'High risk of another stomach ulcer or bleed.', recommendation: 'Avoid unless prescribed with stomach protection.'}}, {ingredient: 'dabigatran', condition: 'chronic-kidney-disease', props: {severity: 'major', effect: 'Dabigatran is cleared by the kidneys; it builds up when they are weak, raising bleeding risk.', recommendation: 'The dose must be matched to kidney function, or another blood thinner chosen.'}}, {ingredient: 'dabigatran', condition: 'ulcer-history', props: {severity: 'moderate', effect: 'Higher risk of stomach bleeding.', recommendation: 'Make sure the prescriber knows about the ulcer history.'}}, {ingredient: 'digoxin', condition: 'chronic-kidney-disease', props: {severity: 'moderate', effect: 'Digoxin builds up when the kidneys are weak.', recommendation: 'Levels and dose should be checked.'}}, {ingredient: 'glipizide', condition: 'chronic-kidney-disease', props: {severity: 'moderate', effect: 'Higher risk of prolonged low blood sugar.', recommendation: 'Ask whether the dose suits kidney function.'}}, {ingredient: 'prednisone', condition: 'type-2-diabetes', props: {severity: 'moderate', effect: 'Steroids raise blood sugar.', recommendation: 'Check blood sugar more often while taking it.'}}, {ingredient: 'prednisone', condition: 'osteoporosis', props: {severity: 'moderate', effect: 'Steroids thin the bones