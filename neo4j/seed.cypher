SET t.dose = r.dose, t.slots = r.slots, t.prescriber = r.prescriber, t.purpose = r.purpose, t.since = date(r.since);

UNWIND [{patient: 'ramesh', food: 'grapefruit', frequency: 'A large glass every morning', slot: 'morning'}, {patient: 'ramesh', food: 'coffee', frequency: 'Two cups with breakfast', slot: 'morning'}, {patient: 'ramesh', food: 'leafy-greens', frequency: 'Palak or saag a few times a week', slot: 'evening'}, {patient: 'margaret', food: 'coffee', frequency: 'A cup on waking', slot: 'morning'}, {patient: 'margaret', food: 'dairy', frequency: 'Milk with breakfast', slot: 'morning'}, {patient: 'margaret', food: 'alcohol', frequency: 'A glass of wine most evenings', slot: 'evening'}, {patient: 'joseph', food: 'coffee', frequency: 'One cup mid-morning', slot: 'midday'}] AS r MATCH (p:Patient {id: r.patient}), (f:Food {id: r.food})
MERGE (p)-[c:CONSUMES]->(f) SET c.frequency = r.frequency, c.slot = r.slot;
