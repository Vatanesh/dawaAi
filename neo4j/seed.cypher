MERGE (i)-[e:CONTRAINDICATED_IN]->(c) SET e += r.props;

UNWIND [{id: 'warfarin', drugbank: 'Warfarin'}, {id: 'apixaban', drugbank: 'Apixaban'}, {id: 'rivaroxaban', drugbank: 'Rivaroxaban'}, {id: 'clopidogrel', drugbank: 'Clopidogrel'}, {id: 'aspirin', drugbank: 'Acetylsalicylic acid'}, {id: 'ibuprofen', drugbank: 'Ibuprofen'}, {id: 'naproxen', drugbank: 'Naproxen'}, {id: 'acetaminophen', drugbank: 'Acetaminophen'}, {id: 'diphenhydramine', drugbank: 'Diphenhydramine'}, {id: 'metformin', drugbank: 'Metformin'}, {id: 'lisinopril', drugbank: 'Lisinopril'}, {id: 'amlodipine', drugbank: 'Amlodipine'}, {id: 'metoprolol', drugbank: 'Metoprolol'}, {id: 'spironolactone', drugbank: 'Spironolactone'}, {id: 'atorvastatin', drugbank: 'Atorvastatin'}, {id: 'simvastatin', drugbank: 'Simvastatin'}, {id: 'amiodarone', drugbank: 'Amiodarone'}, {id: 'levothyroxine', drugbank: 'Levothyroxine'}, {id: 'omeprazole', drugbank: 'Omeprazole'}, {id: 'sertraline', drugbank: 'Sertraline'}, {id: 'tramadol', drugbank: 'Tramadol'}, {id: 'zolpidem', drugbank: 'Zolpidem'}, {id: 'alendronate', drugbank: 'Alendronic acid'}, {id: 'clarithromycin', drugbank: 'Clarithromycin'}, {id: 'ciprofloxacin', drugbank: 'Ciprofloxacin'}, {id: 'fluconazole', drugbank: 'Fluconazole'}, {id: 'potassium-chloride', drugbank: 'Potassium chloride'}, {id: 'ginkgo', drugbank: 'Ginkgo biloba'}, {id: 'omega-3', drugbank: 'Omega-3-acid ethyl esters'}, {id: 'vitamin-e', drugbank: 'Vitamin E'}, {id: 'vitamin-d3', drugbank: 'Cholecalciferol'}, {id: 'calcium', drugbank: 'Calcium carbonate'}, {id: 'magnesium', drugbank: 'Magnesium oxide'}, {id: 'dabigatran', drugbank: 'Dabigatran etexilate'}, {id: 'edoxaban', drugbank: 'Edoxaban'}, {id: 'digoxin', drugbank: 'Digoxin'}, {id: 'furosemide', drugbank: 'Furosemide'}, {id: 'hydrochlorothiazide', drugbank: 'Hydrochlorothiazide'}, {id: 'losartan', drugbank: 'Losartan'}, {id: 'ramipril', drugbank: 'Ramipril'}, {id: 'gabapentin', drugbank: 'Gabapentin'}, {id: 'donepezil', drugbank: 'Donepezil'}, {id: 'prednisone', drugbank: 'Prednisone'}, {id: 'glipizide', drugbank: 'Glipizide'}, {id: 'tamsulosin', drugbank: 'Tamsulosin'}, {id: 'oxycodone', drugbank: 'Oxycodone'}, {id: 'lorazepam', drugbank: 'Lorazepam'}, {id: 'clonazepam', drugbank: 'Clonazepam'}, {id: 'quetiapine', drugbank: 'Quetiapine'}, {id: 'citalopram', drugbank: 'Citalopram'}, {id: 'escitalopram', drugbank: 'Escitalopram'}, {id: 'amitriptyline', drugbank: 'Amitriptyline'}, {id: 'pantoprazole', drugbank: 'Pantoprazole'}, {id: 'celecoxib', drugbank: 'Celecoxib'}, {id: 'diclofenac', drugbank: 'Diclofenac'}, {id: 'allopurinol', drugbank: 'Allopurinol'}] AS r MATCH (i:ActiveIngredient {id: r.id}), (d:Drug)
WHERE toLower(d.name) = toLower(r.drugbank) OR toLower(d.name) STARTS WITH toLower(r.drugbank) + ' '
OR toLower(d.name) = toLower(i.name)
MERGE (i)-[:SAME_AS]->(d);

UNWIND [{id: 'ramesh', name: 'Ramesh Iyer', age: 78, sex: 'male', relation: 'Dad'}, {id: 'margaret', name: 'Margaret Okafor', age: 74, sex: 'female', relation: 'Mum'}, {id: 'joseph', name: 'Joseph Martin', age: 69, sex: 'male', relation: 'Uncle Joe'}] AS r MERGE (p:Patient {id: r.id}) SET p.name = r.name, p.age = r.age, p.sex = r.sex, p.relation = r.relation;

UNWIND [{patient: 'ramesh', condition: 'atrial-fibrillation'}, {patient: 'ramesh', condition: 'hypertension'}, {patient: 'ramesh', condition: 'type-2-diabetes'}, {patient: 'ramesh', condition: 'hypothyroidism'}, {patient: 'ramesh', condition: 'osteoarthritis'}, {patient: 'margaret', condition: 'depression'}, {patient: 'margaret', condition: 'osteoporosis'}, {patient: 'margaret', condition: 'gerd'}, {patient: 'margaret', condition: 'insomnia'}, {patient: 'margaret', condition: 'fall-risk'}, {patient: 'joseph', condition: 'type-2-diabetes'}, {patient: 'joseph', condition: 'hypertension'}] AS r MATCH (p:Patient {id: r.patient}), (c:Condition {id: r.condition}) MERGE (p)-[:HAS_CONDITION]->(c);

