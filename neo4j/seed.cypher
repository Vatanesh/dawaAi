CREATE CONSTRAINT patient_id IF NOT EXISTS FOR (n:Patient) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT medication_id IF NOT EXISTS FOR (n:Medication) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT activeingredient_id IF NOT EXISTS FOR (n:ActiveIngredient) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT drugclass_id IF NOT EXISTS FOR (n:DrugClass) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT food_id IF NOT EXISTS FOR (n:Food) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT nutrient_id IF NOT EXISTS FOR (n:Nutrient) REQUIRE n.id IS UNIQUE;

CREATE CONSTRAINT condition_id IF NOT EXISTS FOR (n:Condition) REQUIRE n.id IS UNIQUE;

