 Okoro, rheumatologist', purpose: 'Bone strength', since: '2022-02-01'}, {patient: 'margaret', medication: 'omeprazole-20', dose: '20 mg, before breakfast', slots: ['morning'], prescriber: 'Dr. Claire Hughes, GP', purpose: 'Reflux', since: '2017-04-22'}, {patient: 'margaret', medication: 'tramadol-50', dose: '50 mg, twice daily', slots: ['midday', 'evening'], prescriber: 'Dr. Ben Brooks, orthopaedics', purpose: 'Back pain', since: '2024-07-30'}, {patient: 'margaret', medication: 'zolpidem-5', dose: '5 mg at bedtime', slots: ['bedtime'], prescriber: 'Dr. Claire Hughes, GP', purpose: 'Sleep', since: '2023-10-03'}, {patient: 'margaret', medication: 'tylenol-pm', dose: '1 to 2 caplets on bad nights', slots: ['bedtime'], prescriber: 'Self (over the counter)', purpose: 'Sleep and aches', since: '2024-01-11'}, {patient: 'margaret', medication: 'st-johns-wort-300', dose: '300 mg, 1 capsule', slots: ['morning'], prescriber: 'Self (health-food shop)', purpose: 'Mood', since: '2024-03-05'}, {patient: 'margaret', medication: 'calcium-d', dose: '1 tablet with breakfast', slots: ['morning'], prescriber: 'Self (over the counter)', purpose: 'Bones', since: '2022-02-01'}, {patient: 'joseph', medication: 'metformin-500', dose: '500 mg, twice daily with meals', slots: ['morning', 'evening'], prescriber: 'Dr. Priya Nair, GP', purpose: 'Blood sugar', since: '2020-05-19'}, {patient: 'joseph', medication: 'metoprolol-25', dose: '25 mg, twice daily', slots: ['morning', 'evening'], prescriber: 'Dr. Priya Nair, GP', purpose: 'Blood pressure', since: '2021-01-08'}, {patient: 'joseph', medication: 'atorvastatin-40', dose: '40 mg, 1 tablet', slots: ['bedtime'], prescriber: 'Dr. Priya Nair, GP', purpose: 'Cholesterol', since: '2021-01-08'}] AS r MATCH (p:Patient {id: r.patient}), (m:Medication {id: r.medication})
