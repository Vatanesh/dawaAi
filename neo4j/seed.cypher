t: 'fluconazole', strength: '150 mg'}, {medication: 'k-dur', ingredient: 'potassium-chloride', strength: '20 mEq'}, {medication: 'st-johns-wort-300', ingredient: 'st-johns-wort', strength: '300 mg'}, {medication: 'ginkgo-120', ingredient: 'ginkgo', strength: '120 mg'}, {medication: 'fish-oil', ingredient: 'omega-3', strength: '1000 mg'}, {medication: 'evening-multi', ingredient: 'vitamin-k', strength: '80 mcg'}, {medication: 'evening-multi', ingredient: 'vitamin-e', strength: '45 IU'}, {medication: 'evening-multi', ingredient: 'calcium', strength: '200 mg'}, {medication: 'evening-multi', ingredient: 'iron', strength: '8 mg'}, {medication: 'evening-multi', ingredient: 'vitamin-d3', strength: '1000 IU'}, {medication: 'calcium-d', ingredient: 'calcium', strength: '600 mg'}, {medication: 'calcium-d', ingredient: 'vitamin-d3', strength: '800 IU'}, {medication: 'magnesium-400', ingredient: 'magnesium', strength: '400 mg'}, {medication: 'pradaxa', ingredient: 'dabigatran', strength: '150 mg'}, {medication: 'savaysa', ingredient: 'edoxaban', strength: '60 mg'}, {medication: 'lanoxin', ingredient: 'digoxin', strength: '125 mcg'}, {medication: 'lasix', ingredient: 'furosemide', strength: '40 mg'}, {medication: 'hctz', ingredient: 'hydrochlorothiazide', strength: '25 mg'}, {medication: 'cozaar', ingredient: 'losartan', strength: '50 mg'}, {medication: 'altace', ingredient: 'ramipril', strength: '5 mg'}, {medication: 'neurontin', ingredient: 'gabapentin', strength: '300 mg'}, {medication: 'aricept', ingredient: 'donepezil', strength: '10 mg'}, {medication: 'prednisone-10', ingredient: 'prednisone', strength: '10 mg'}, {medication: 'glucotrol', ingredient: 'glipizide', strength: '5 mg'}, {medication: 'flomax', ingredient: 'tamsulosin', strength: '0.4 mg'}, {medication: 'oxycontin', ingredient: 'oxycodone', strength: '5 mg'}, {medication: 'ativan', ingredient: 'lorazepam', strength: '1 mg'}, {medication: 'klonopin', ingredient: 'clonazepam', strength: '0.5 mg'}, {medication: 'ser