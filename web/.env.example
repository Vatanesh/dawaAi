# Copy to .env.local. Leave NEO4J_URI empty to run on the built-in demo graph.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Neo4j Agent Memory sidecar (memory-service/). Leave empty for in-process memory.
MEMORY_SERVICE_URL=http://127.0.0.1:8100

# AI that writes answers up from graph facts. The graph always decides what is true; without a key,
# answers come straight from the graph (free). NaraRouter has a free tier (router.bynara.id).
NARA_API_KEY=
# Models tried in order (the first your plan allows is used).
# NARA_MODELS=auto/bynara,agnes-2.5-flash,laguna-s-2.1
# Optional and paid: Claude with graph tools instead. AI_PROVIDER=router|claude|graph forces one.
# ANTHROPIC_API_KEY=
# AI_PROVIDER=

# White-label: rebrand for an insurer, hospital network or care facility without code changes.
# NEXT_PUBLIC_BRAND_NAME=DawaAI
# NEXT_PUBLIC_BRAND_TAGLINE=Medication safety for the people you care for
# NEXT_PUBLIC_BRAND_COLOR=#0e7c66
# NEXT_PUBLIC_BRAND_PARTNER=Sunrise Senior Living
