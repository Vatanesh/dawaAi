// Writes neo4j/seed.cypher: the same load as seed-neo4j.ts as a plain script that can be pasted
// into Neo4j Browser / Aura Query or run with cypher-shell.
//   npm run export:cypher

import { mkdirSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { literal, statements } from "./graph-statements";

const out = resolve(dirname(fileURLToPath(import.meta.url)), "../../neo4j/seed.cypher");
const body = statements()
  .map((s) => (s.rows ? s.cypher.replace("$rows", literal(s.rows)) : s.cypher).replace(/\n\s+/g, "\n") + ";")
  .join("\n\n");

mkdirSync(dirname(out), { recursive: true });
writeFileSync(
  out,
  `// Dawa demo knowledge graph. Generated by \`npm run export:cypher\` from web/src/lib/graph/seed-data.ts.\n// Safe to re-run: every statement MERGEs. See CONTRACT.md for the schema.\n\n${body}\n`,
);
console.log(`Wrote ${out}`);
